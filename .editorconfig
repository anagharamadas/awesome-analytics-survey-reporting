root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4
max_line_length = 88

[*.{ts,tsx,js,jsx,json,css,html,yml,yaml}]
indent_size = 2

[*.md]
# Markdown uses trailing double-space for hard line breaks.
trim_trailing_whitespace = false

[*.csv]
# Data files are read-only inputs and reproducible outputs. Do not reformat.
trim_trailing_whitespace = false
insert_final_newline = false
